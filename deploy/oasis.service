[Unit]
# Слой 2: поднимает Docker-стек splithome.ru при загрузке сервера.
# Страховка к restart:always — покрывает случай, когда контейнеры были
# удалены (docker compose down): политика restart тут бессильна, а юнит
# пересоздаёт стек заново.
Description=SplitHome (oasis) docker compose stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/oasis
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose stop
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
